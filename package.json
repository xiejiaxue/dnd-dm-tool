{
  "name": "dnd-dm-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n worker,client -c blue,green \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "npm run build:client && wrangler dev --local --port 8787 --persist-to .wrangler/state --compatibility-date=2026-08-08",
    "dev:client": "vite client",
    "build": "npm run build:client && npm run check:worker",
    "build:client": "vite build client",
    "start": "wrangler dev --local --port 8787 --persist-to .wrangler/state --compatibility-date=2026-08-08",
    "cf:types": "wrangler types worker/worker-configuration.d.ts && node scripts/normalize-worker-types.mjs worker/worker-configuration.d.ts",
    "check:worker": "tsc --project tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply dnd-dm-tool --local",
    "db:migrate:remote": "wrangler d1 migrations apply dnd-dm-tool --remote",
    "deploy": "npm run build && npm run deploy:production",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test": "npm run test:domain && npm run test:worker",
    "test:domain": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "data:update": "node scripts/data-update.mjs",
    "data:publish": "node scripts/data-publish.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "fuse.js": "^7.0.0",
    "konva": "^9.3.6",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "sharp": "^0.35.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.5.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
